---
import type { useTranslations } from '@/i18n/utils';

interface Props {
  t: ReturnType<typeof useTranslations>;
  locale: 'pt' | 'en';
}

const { t, locale } = Astro.props;

const cvHref = locale === 'pt' ? '/cv-pt.pdf' : '/cv-en.pdf';
const year = new Date().getFullYear();
---

<footer class="border-t border-purple-dim border-opacity-20 py-20 px-6 md:px-10">
  <div class="section-container">
    <div class="grid md:grid-cols-2 gap-16 items-start">

      <!-- LEFT: formulário -->
      <div>
        <p class="font-syne font-bold text-2xl text-purple-ghost leading-snug mb-3">
          {t.footer.heading}
        </p>
        <p class="text-sm text-purple-light opacity-60 font-light mb-8">
          {t.footer.subheading}
        </p>

        <form id="contact-form" class="space-y-3" novalidate>
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label for="name" class="footer-label">{t.footer.form.name}</label>
              <input id="name" name="name" type="text" required
                placeholder={t.footer.form.namePlaceholder}
                class="footer-input" />
            </div>
            <div class="space-y-1.5">
              <label for="email" class="footer-label">{t.footer.form.email}</label>
              <input id="email" name="email" type="email" required
                placeholder={t.footer.form.emailPlaceholder}
                class="footer-input" />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="message" class="footer-label">{t.footer.form.message}</label>
            <textarea id="message" name="message" rows="4" required
              placeholder={t.footer.form.messagePlaceholder}
              class="footer-input resize-none"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full justify-center">
            {t.footer.form.submit}
          </button>

          <p id="form-status" class="text-center text-sm text-purple-bright opacity-70 hidden"></p>
        </form>
      </div>

      <!-- RIGHT: info -->
      <div class="flex flex-col gap-8 md:pt-2">

        <div>
          <span class="font-syne font-bold text-xl text-purple-ghost tracking-tight">
            ba<span class="text-purple-bright">.</span>
          </span>
          <p class="text-sm text-purple-light opacity-70 font-light leading-relaxed mt-3 max-w-xs">
            {t.about.bio1}
          </p>
        </div>

        <!-- social icons -->
        <div class="flex items-center gap-4">
          <a href="https://github.com/alvimdev" target="_blank" rel="noopener noreferrer" class="footer-icon-link" title="GitHub">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>

          <a href="https://linkedin.com/in/bernardo-alvim" target="_blank" rel="noopener noreferrer" class="footer-icon-link" title="LinkedIn">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>

          <a href={cvHref} download class="footer-icon-link" title="Currículo">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        </div>

        <p class="text-xs text-purple-light opacity-30 mt-auto">
          © {year} Bernardo Alvim. {t.footer.rights}
        </p>

      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    status.classList.remove('hidden');
    status.textContent = '✓ Mensagem enviada!';
  });
</script>