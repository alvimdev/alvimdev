---
import type { useTranslations } from '@/i18n/utils';

interface Props {
  t: ReturnType<typeof useTranslations>;
  locale: 'pt' | 'en';
}

const { t, locale } = Astro.props;

const cvHref = locale === 'pt' ? '/curriculo' : '/resume';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden px-6 py-20 md:px-10"
>
  <canvas id="hero-canvas" class="absolute inset-0 pointer-events-none z-0"></canvas>

  <div class="relative z-10 flex flex-col-reverse md:flex-row items-center justify-between gap-16 w-full max-w-5xl mx-auto">

    <!-- LEFT -->
    <div class="flex-1 min-w-0 text-center md:text-left">

      <div class="inline-block text-[11px] tracking-[0.18em] uppercase text-purple-bright border border-purple-dim rounded-full px-4 py-1 mb-6 opacity-0 animate-[fadeUp_0.7s_ease_forwards_0.1s]">
        {t.hero.tag}
      </div>

      <h1 class="hero-title font-syne font-extrabold leading-none tracking-tight text-purple-ghost mb-3 opacity-0 animate-[fadeUp_0.7s_ease_forwards_0.25s]">
        Bernardo<br />
        <span class="text-purple-bright">Alvim</span>
      </h1>

      <p class="text-purple-light font-light tracking-widest text-sm mb-7 opacity-0 animate-[fadeUp_0.7s_ease_forwards_0.4s]">
        <span class="hero-brush-mark">alvimdev</span>
      </p>

      <p class="text-purple-light font-light leading-relaxed text-[15px] max-w-md mx-auto md:mx-0 mb-10 opacity-0 animate-[fadeUp_0.7s_ease_forwards_0.55s]">
        {t.hero.bio}
      </p>

      <div class="flex flex-wrap gap-3 justify-center md:justify-start opacity-0 animate-[fadeUp_0.7s_ease_forwards_0.7s]">

        <a href="https://github.com/alvimdev" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-bg-card border border-purple-dim text-purple-ghost text-sm font-medium transition-all duration-200 hover:-translate-y-0.5 hover:border-purple-mid">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          {t.hero.github}
        </a>

        <a href="https://linkedin.com/in/bernardo-alvim" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-bg-card border border-purple-dim text-purple-ghost text-sm font-medium transition-all duration-200 hover:-translate-y-0.5 hover:border-purple-mid">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          {t.hero.linkedin}
        </a>

        <a href={cvHref} target="_blank"
           class="hero-resume-btn inline-flex items-center gap-2 px-5 py-3 rounded-full text-purple-ghost text-sm font-medium transition-all duration-200 hover:-translate-y-0.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          {t.hero.resume}
        </a>

      </div>
    </div>

    <!-- RIGHT: photo -->
    <div class="relative shrink-0 flex items-center justify-center">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>

      <div class="relative w-64 h-64 md:w-72 md:h-72">
        <div class="hero-orbit"></div>
        <div class="hero-ring">
          <div class="hero-ring-inner"></div>
        </div>

        <div class="hero-photo-wrap relative z-10 w-full h-full">
            <img src="/profile.jpg" alt="Bernardo Alvim" class="w-full h-full object-cover rounded-full border-4 border-bg-card">
          <!-- <div class="w-full h-full flex items-center justify-center">
            <svg viewBox="0 0 80 80" fill="none" class="w-24 h-24 opacity-30">
              <circle cx="40" cy="30" r="16" fill="#7c5cbf"/>
              <path d="M8 68c0-17.673 14.327-32 32-32s32 14.327 32 32" fill="#5c3b9e"/>
            </svg>
          </div> -->
        </div>
      </div>
    </div>

  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-30">
    <span class="text-xs tracking-widest text-purple-light uppercase">scroll</span>
    <div class="hero-scroll-line w-px h-8"></div>
  </div>
</section>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const section = document.getElementById('hero') as HTMLElement;
  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;
  let mouse = { x: 0.6, y: 0.5 };
  let trail: { x: number; y: number; life: number; r: number }[] = [];

  function makeBubble() {
    const b = {
      x: Math.random() * W, y: Math.random() * 800,
      r: 2 + Math.random() * 5, speed: 0.3 + Math.random() * 0.6,
      opacity: 0.04 + Math.random() * 0.12, drift: (Math.random() - 0.5) * 0.4,
      hue: 260 + Math.random() * 60,
      reset() {
        this.x = Math.random() * W; this.y = H + 20;
        this.r = 2 + Math.random() * 5; this.speed = 0.3 + Math.random() * 0.6;
        this.opacity = 0.04 + Math.random() * 0.12;
        this.drift = (Math.random() - 0.5) * 0.4; this.hue = 260 + Math.random() * 60;
      },
      update() {
        this.y -= this.speed; this.x += this.drift;
        if (this.y < -20 || this.x < -20 || this.x > W + 20) this.reset();
      },
      draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.strokeStyle = `hsla(${this.hue},70%,70%,${this.opacity})`; ctx.lineWidth = 1; ctx.stroke();
        ctx.beginPath(); ctx.arc(this.x - this.r * 0.3, this.y - this.r * 0.3, this.r * 0.2, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${this.hue},80%,90%,${this.opacity * 0.8})`; ctx.fill();
      },
    };
    return b;
  }

  const bubbles = Array.from({ length: 55 }, makeBubble);

  function resize() { W = canvas.width = section.offsetWidth; H = canvas.height = section.offsetHeight; }

  section.addEventListener('mousemove', (e) => {
    const rect = section.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    mouse.x = mx / W; mouse.y = my / H;
    trail.push({ x: mx, y: my, life: 1, r: 3 + Math.random() * 4 });
    if (trail.length > 12) trail.shift();
  });

  function loop() {
    ctx.clearRect(0, 0, W, H);
    const diag = Math.sqrt(W * W + H * H);
    const px = W * mouse.x * 0.08, py = H * mouse.y * 0.08;
    for (let i = -diag; i < diag * 2; i += 90) {
      ctx.beginPath();
      ctx.moveTo(i - diag * Math.cos(-Math.PI / 4) + px, -diag * Math.sin(-Math.PI / 4) + py);
      ctx.lineTo(i + diag * Math.cos(-Math.PI / 4) + px,  diag * Math.sin(-Math.PI / 4) + py);
      ctx.strokeStyle = `rgba(130,90,220,${0.025 + 0.015 * Math.sin(Date.now() * 0.0004 + i * 0.02)})`;
      ctx.lineWidth = 1; ctx.stroke();
    }
    bubbles.forEach(b => { b.update(); b.draw(); });
    trail.forEach(t => {
      t.life -= 0.06; t.r += 1.2;
      ctx.beginPath(); ctx.arc(t.x, t.y, t.r, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(180,130,255,${t.life * 0.25})`; ctx.lineWidth = 0.8; ctx.stroke();
    });
    trail = trail.filter(t => t.life > 0);
    requestAnimationFrame(loop);
  }

  resize(); window.addEventListener('resize', resize); loop();
</script>