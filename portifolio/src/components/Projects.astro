---
import type { useTranslations } from '@/i18n/utils';

interface Props {
  t: ReturnType<typeof useTranslations>;
}

const { t } = Astro.props;

interface Project {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  repo?: string;
  live?: string;
}

const projects: Project[] = [
  {
    title: t.projects.p1.title,
    description: t.projects.p1.description,
    tags: ['NextJS', 'TypeScript', 'Java', 'Spring Boot', 'MySQL', 'Google APIs', 'FocusNF'],
    image: '/projects/p1.jpeg',
    repo: 'https://github.com/alvim-puc/hortifruti-sl',
    live: 'https://hortifrutisl.zone.id',
  },
  {
    title: t.projects.p2.title,
    description: t.projects.p2.description,
    tags: ['Java', 'Spring Boot', 'PostgreSQL'],
    image: '/projects/p2.png',
    repo: 'https://github.com/alvim-puc/cash-craft',
    live: 'https://cash-craft.onrender.com',
  },
  {
    title: t.projects.p3.title,
    description: t.projects.p3.description,
    tags: ['Astro', 'TypeScript', 'Tailwind CSS', 'Spring Boot', 'MySQL'],
    image: '/projects/p3.png',
    repo: 'https://github.com/alvim-puc/avila-lotus',
    live: 'https://avila-lotus.onrender.com',
  },
  {
    title: t.projects.p4.title,
    description: t.projects.p4.description,
    tags: ['Astro', 'JavaScript', 'Spring Boot', 'MySQL'],
    image: '/projects/p4.png',
    repo: 'https://github.com/alvim-puc/gostoo',
  },
];
---

<section id="projects" class="relative py-32 px-6 md:px-10">
  <div class="section-container">

    <div class="flex items-center gap-4 mb-16">
      <span class="text-xs tracking-[0.18em] uppercase text-purple-bright opacity-60">03</span>
      <div class="h-px w-14 bg-purple-dim opacity-40"></div>
      <h2 class="font-syne font-bold text-3xl text-purple-ghost">
        {t.projects.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {projects.map((project) => (
        <article class="project-card group">

          <!-- banner -->
          <div class="project-banner">
            {project.image
              ? <img src={project.image} alt={project.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              : <div class="w-full h-full project-banner-fallback"></div>
            }
          </div>

          <!-- content -->
          <div class="flex flex-col flex-1 p-5">
            <h3 class="font-syne font-bold text-lg text-purple-ghost mb-2 group-hover:text-purple-bright transition-colors duration-200">
              {project.title}
            </h3>
            <p class="text-sm text-purple-light opacity-70 leading-relaxed font-light mb-5 flex-1">
              {project.description}
            </p>

            <div class="flex items-end justify-between gap-4 mt-auto">
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="skill-chip">{tag}</span>
                ))}
              </div>

              <div class="flex items-center gap-3 shrink-0">
                {project.repo && (
                  <a href={project.repo} target="_blank" rel="noopener noreferrer" class="project-link" title="Repositório">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  </a>
                )}
                {project.live && (
                  <a href={project.live} target="_blank" rel="noopener noreferrer" class="project-link" title="Live">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>